@base = http://localhost:8080
@page0 = 0

### -------------------------------------------------------------------
### VARIABLES MANUALES (si tu API NO devuelve ids en respuestas)
### Completa estos valores si las pruebas que las obtienen automáticamente no te sirven.
### -------------------------------------------------------------------
@hostId = REEMPLAZA_CON_ID_HOST
@userId = REEMPLAZA_CON_ID_USER
@placeId = 40ed073c-e260-4a6d-9760-aece23f0e1d3
@bookingId = a1fad456-acac-4cf6-ad99-b09fcb696b90
@commentId = REEMPLAZA_CON_ID_COMMENT
# Fechas fijas (formato ISO local: yyyy-MM-ddTHH:mm:ss)
@checkIn  = 2025-11-20T15:00:00
@checkOut = 2025-11-22T11:00:00
@tokenUser = eyJhbGciOiJIUzM4NCJ9.eyJyb2xlIjoiUk9MRV9VU0VSIiwibmFtZSI6IlVzZXIgVGVzdCIsImVtYWlsIjoidXNlckB0ZXN0LmNvbSIsInN1YiI6IjRmMmQxMTliLTM4MzUtNDlmNy04NTUxLTUyMmUzMDg1Mjk5MiIsImlhdCI6MTc2Mjg5MDc1OCwiZXhwIjoxNzYyODk0MzU4fQ.VRJpbGwBshDwK0vyOeMo8cINVvrgSvRpU_KSvpG-btQlViLRtnE92r1i4JhQHQM0
### -------------------------------------------------------------------
### AUTH – REGISTRO HOST
### -------------------------------------------------------------------
# @name RegisterHost
POST {{base}}/api/auth
Content-Type: application/json

{
  "name": "Host Test",
  "surname": "Demo",
  "email": "host@test.com",
  "phone": "3100000000",
  "birthDate": "1990-01-01",
  "country": "CO",
  "photoUrl": "hola",
  "password": "ClaveFuerte1",
  "role": "HOST"
}
> {%
    // Ajusta según tu ResponseDTO; si devuelves id en data, extráelo aquí.
    // client.global.set("hostId", response.body.data?.id);
%}

### -------------------------------------------------------------------
### AUTH – REGISTRO USER
### -------------------------------------------------------------------
# @name RegisterUser
POST {{base}}/api/auth
Content-Type: application/json

{
  "name": "User Test",
  "surname": "Demo",
  "email": "user@test.com",
  "phone": "3110000000",
  "birthDate": "1995-02-02",
  "photoUrl": "hola",
  "country": "CO",
  "password": "ClaveFuerte1",
  "role": "USER"
}
> {%
    // client.global.set("userId", response.body.data?.id);
%}

### -------------------------------------------------------------------
### LOGIN HOST  → tokenHost
### -------------------------------------------------------------------
# @name LoginHost
POST {{base}}/api/auth/login
Content-Type: application/json

{
  "email": "host@test.com",
  "password": "ClaveFuerte1"
}
> {%
    // Ajusta si tu wrapper es {error, data:{token}}
    const token = response.body?.message?.token || response.body?.token;
    if (token) client.global.set("tokenHost", token);
%}

### -------------------------------------------------------------------
### LOGIN USER  → tokenUser
### -------------------------------------------------------------------
# @name LoginUser
POST {{base}}/api/auth/login
Content-Type: application/json

{
  "email": "user@test.com",
  "password": "ClaveFuerte1"
}
> {%
    const token = response.body?.data?.token || response.body?.token;
    if (token) client.global.set("tokenUser", token);
%}

### -------------------------------------------------------------------
### USERS – COMPLETAR DATOS DE HOST (si tu endpoint lo usa)
### -------------------------------------------------------------------
# @name CompleteHost
PUT {{base}}/api/users/{{hostId}}/host
Authorization: Bearer {{tokenHost}}
Content-Type: application/json

{
  "about": "Anfitrión de prueba",
  "phone": "3100000000"
}

### -------------------------------------------------------------------
### USERS – EDITAR PERFIL USER
### -------------------------------------------------------------------
# @name EditUser
PUT {{base}}/api/users/{{userId}}
Authorization: Bearer {{tokenUser}}
Content-Type: application/json

{
  "name": "User Test Editado",
  "phone": "3110000001",
  "photoUrl": "https://picsum.photos/200",
  "birthDate": "1995-02-02"
}

### -------------------------------------------------------------------
### USERS – CAMBIAR CONTRASEÑA USER
### -------------------------------------------------------------------
# @name ChangePasswordUser
PATCH {{base}}/api/users/{{userId}}
Authorization: Bearer {{tokenUser}}
Content-Type: application/json

{
  "currentPassword": "ClaveFuerte1",
  "newPassword": "ClaveNueva2"
}

### -------------------------------------------------------------------
### PLACES – CREAR LUGAR (HOST)
### -------------------------------------------------------------------
# @name CreatePlace
POST {{base}}/api/places
Authorization: Bearer {{tokenHost}}
Content-Type: application/json

{
  "title": "Finca Demo",
  "description": "Hermosa finca de prueba con todo lo necesario.",
  "price": 250000,
  "placeType": "FARM",
  "capacity": 5,
  "country": "CO",
  "department": "Quindío",
  "city": "Armenia",
  "neighborhood": "La Florida",
  "street": "Km 3",
  "postalCode": "630001",
  "amenities": ["PETS_ALLOWED", "FREE_STREET_PARKING", "ESSENTIALS"],
  "latitude": 4.533,
  "longitude": -75.681,
  "picsUrl": ["hola1"]
}
> {%
    // Si tu respuesta retorna id del lugar en data, guárdalo
    // client.global.set("placeId", response.body?.data?.id || response.body?.data);
%}

### -------------------------------------------------------------------
### IMAGES – SUBIR 2 IMÁGENES (1..10) Y MARCAR PRINCIPAL = 0
### -------------------------------------------------------------------
# @name UploadImages
POST {{base}}/api/places/{{placeId}}/images?mainIndex=0
Authorization: Bearer {{tokenHost}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="files"; filename="foto1.jpg"
Content-Type: image/jpeg

< ./test-assets/foto1.jpg
--WebAppBoundary
Content-Disposition: form-data; name="files"; filename="foto2.jpg"
Content-Type: image/jpeg

< ./test-assets/foto2.jpg
--WebAppBoundary--

### -------------------------------------------------------------------
### PLACES – DETALLE DEL LUGAR
### -------------------------------------------------------------------
# @name PlaceDetail
GET {{base}}/api/places/{{placeId}}/detail

### -------------------------------------------------------------------
### PLACES – AMENIDADES DEL LUGAR
### -------------------------------------------------------------------
# @name PlaceAmenities
GET {{base}}/api/places/{{placeId}}/amenities

### -------------------------------------------------------------------
### PLACES – BÚSQUEDA PAGINADA (10/pg)
### -------------------------------------------------------------------
# @name SearchPlaces
GET {{base}}/api/places/{{page0}}
Content-Type: application/json

{
  "city": "Armenia",
  "minimum": 100000,
  "maximum": 400000
}


### -------------------------------------------------------------------
### BOOKINGS – CREAR RESERVA (USER) – Caso OK (5 días adelante)
### -------------------------------------------------------------------
# @name CreateBooking_ok
POST {{base}}/api/bookings/{{placeId}}
Authorization: Bearer {{tokenUser}}
Content-Type: application/json

{
  "checkIn": "{{checkIn}}",
  "checkOut": "{{checkOut}}",
  "guest_number": 2
}
> {%
    // Guarda bookingId si tu API lo retorna en data
    client.global.set("bookingId", response.body?.data?.id || response.body?.data);
%}

### -------------------------------------------------------------------
### BOOKINGS – CREAR RESERVA (USER) – Caso ERROR (solape o <1 noche)
### -------------------------------------------------------------------
# @name CreateBooking_error
POST {{base}}/api/bookings/{{placeId}}
Authorization: Bearer {{tokenUser}}
Content-Type: application/json

{
  "checkIn": "{{now+6d}}T15:00:00",
  "checkOut": "{{now+6d}}T18:00:00",
  "guest_number": 2
}

### -------------------------------------------------------------------
### BOOKINGS – CONFIRMAR RESERVA (HOST)
### -------------------------------------------------------------------
# @name ConfirmBooking
POST {{base}}/api/bookings/{{bookingId}}/confirm
Authorization: Bearer {{tokenHost}}

### -------------------------------------------------------------------
### BOOKINGS – CANCELAR (USER) – Caso ERROR (dentro de 48h)
### -------------------------------------------------------------------
# @name CreateBooking_48h
POST {{base}}/api/bookings/{{placeId}}
Authorization: Bearer {{tokenUser}}
Content-Type: application/json

{
  "checkIn": "{{now+36h}}",
  "checkOut": "{{now+60h}}",
  "guest_number": 1
}
> {%
    // client.global.set("bookingId48", response.body?.data?.id || response.body?.data);
%}

###@name CancelBooking_fail48
###DELETE {{base}}/api/bookings/{{bookingId48}}
###Authorization: Bearer {{tokenUser}}

### -------------------------------------------------------------------
### BOOKINGS – CANCELAR (USER) – Caso OK (>48h)
### -------------------------------------------------------------------
# @name CancelBooking_ok
DELETE {{base}}/api/bookings/{{bookingId}}
Authorization: Bearer {{tokenUser}}

### -------------------------------------------------------------------
### FAVORITES – ADD (USER)
### -------------------------------------------------------------------
# @name FavAdd
POST {{base}}/api/favorites/{{placeId}}
Authorization: Bearer {{tokenUser}}

### -------------------------------------------------------------------
### FAVORITES – IS MINE?
### -------------------------------------------------------------------
# @name FavIsMine
GET {{base}}/api/favorites/me/{{placeId}}
Authorization: Bearer {{tokenUser}}

### -------------------------------------------------------------------
### FAVORITES – LIST MINE (PAGE)
### -------------------------------------------------------------------
# @name FavListMine
GET {{base}}/api/favorites/me?page=0
Authorization: Bearer {{tokenUser}}

### -------------------------------------------------------------------
### FAVORITES – COUNT (PÚBLICO)
### -------------------------------------------------------------------
# @name FavCount
GET {{base}}/api/favorites/count/{{placeId}}

### -------------------------------------------------------------------
### COMMENTS – (NEGATIVO) Crear comentario ANTES de COMPLETED (debe fallar 400)
### -------------------------------------------------------------------
# @name Comment_beforeCompleted
POST {{base}}/api/places/{{bookingId}}/comments
Authorization: Bearer {{tokenUser}}
Content-Type: application/json

{
  "rating": 5,
  "comment": "Excelente!"
}

### -------------------------------------------------------------------
### COMMENTS – LISTAR POR LUGAR (recientes primero)
### -------------------------------------------------------------------
# @name ListComments
GET {{base}}/api/places/{{placeId}}/comments/{{page0}}

### -------------------------------------------------------------------
### COMMENTS – RESPONDER (HOST)
### -------------------------------------------------------------------
# @name ReplyComment
POST {{base}}/api/comments/{{commentId}}/reply/{{hostId}}
Authorization: Bearer {{tokenHost}}
Content-Type: application/json

{
  "message": "¡Gracias por tu comentario!"
}

### -------------------------------------------------------------------
### STATS – MÉTRICAS DEL LUGAR (HOST)
### -------------------------------------------------------------------
# @name PlaceStats
GET {{base}}/api/places/{{placeId}}/stats?from={{now-30d}}&to={{now+30d}}
Authorization: Bearer {{tokenHost}}

### -------------------------------------------------------------------
### USERS – LISTAR RESERVAS DEL USUARIO (PAGE, opcional body filtro)
### -------------------------------------------------------------------
# @name UserBookings
GET {{base}}/api/users/{{userId}}/bookings/{{page0}}
Authorization: Bearer {{tokenUser}}
Content-Type: application/json

{
  "state": "PENDING"
}

### -------------------------------------------------------------------
### USERS – LISTAR LUGARES DEL HOST (PAGE)
### -------------------------------------------------------------------
# @name HostPlaces
GET {{base}}/api/users/{{hostId}}/places/host/{{page0}}
Authorization: Bearer {{tokenHost}}
